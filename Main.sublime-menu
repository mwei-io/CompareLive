[
    {
        "id": "tools",
        "children": [
            {
                "caption": "-",
                "id": "compare_live_tools_sep_top"
            },
            {
                "caption": "CompareLive",
                "children": [
                    {
                        "caption": "with Selected Tab",
                        "command": "compare_live_compare_with"
                    },
                    {
                        "caption": "End Compare",
                        "command": "compare_live_end"
                    }
                ]
            },
            {
                "caption": "-",
                "id": "compare_live_tools_sep_bottom"
            }
        ]
    },
    {
        "id": "preferences",
        "children": [
            {
                "id": "package-settings",
                "caption": "Package Settings",
                "children": [
                    {
                        "caption": "CompareLive",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/CompareLive/CompareLive.sublime-settings",
                                    "default": "{\n\t$0\n}\n"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
